<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- v0.2: the network only for Wikipedia (search, one article); everything else, built palaces
         included, works offline. No camera. Plane detection and world anchors ask for no runtime
         permission on SDK 6.1 (plane-detection / spatial-anchor docs list none; device to be confirmed). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MemoryPalace"
        tools:targetApi="31">

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.MemoryPalace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- DefaultStage: one Mixed Stage (Full Space, passthrough) holds the whole product -->
            <meta-data
                android:name="pico.spatial.stage.id"
                android:value="MemoryPalaceStage" />
            <meta-data
                android:name="pico.spatial.stage.style"
                android:value="1" />
            <meta-data
                android:name="pico.spatial.stage.immersion"
                android:value="0" />
            <meta-data
                android:name="pico.spatial.stage.immersion_min"
                android:value="0" />
            <meta-data
                android:name="pico.spatial.stage.immersion_max"
                android:value="0" />
        </activity>

        <!-- Transparent helper behind "Choose from files": the system picker's result lands here. -->
        <activity
            android:name=".platform.PickerActivity"
            android:exported="false"
            android:theme="@style/Theme.MemoryPalace" />

        <meta-data android:name="icon.3d.list" android:resource="@array/icon_3d_list" />
        <meta-data android:name="icon.sdf.list" android:resource="@array/icon_sdf_list" />
    </application>

</manifest>
