{"id":"tang300-4","zh":"唐诗三百首 · 卷四","en":"300 Tang Poems · Vol. 4","tree":[{"t":"李白 3","k":[{"t":"《庐山谣寄卢侍御虚舟》一","k":[{"f":"我本楚狂人","b":"凤歌笑孔丘"},{"f":"手持绿玉杖","b":"朝别黄鹤楼"},{"f":"五岳寻仙不辞远","b":"一生好入名山游"},{"f":"庐山秀出南斗傍","b":"屏风九叠云锦张"},{"f":"影落明湖青黛光","b":"金阙前开二峰长 银河倒挂三石梁"},{"f":"香炉瀑布遥相望","b":"回崖沓嶂凌苍苍"},{"f":"翠影红霞映朝日","b":"鸟飞不到吴天长"}],"a":"李白"},{"t":"《庐山谣寄卢侍御虚舟》二","k":[{"f":"登高壮观天地间","b":"大江茫茫去不还"},{"f":"黄云万里动风色","b":"白波九道流雪山"},{"f":"好为庐山谣","b":"兴因庐山发"},{"f":"闲窥石镜清我心","b":"谢公行处苍苔没"},{"f":"早服还丹无世情","b":"琴心三叠道初成"},{"f":"遥见仙人彩云里","b":"手把芙蓉朝玉京"},{"f":"先期汗漫九垓上","b":"愿接卢敖游太清"}],"a":"李白"},{"t":"《梦游天姥吟留别》一","k":[{"f":"海客谈瀛洲","b":"烟涛微茫信难求"},{"f":"越人语天姥","b":"云霞明灭或可睹"},{"f":"天姥连天向天横","b":"势拔五岳掩赤城"},{"f":"天台四万八千丈","b":"对此欲倒东南倾"},{"f":"我欲因之梦吴越","b":"一夜飞度镜湖月"},{"f":"湖月照我影","b":"送我至剡溪"},{"f":"谢公宿处今尚在","b":"渌水荡漾清猿啼"},{"f":"脚著谢公屐","b":"身登青云梯"}],"a":"李白"},{"t":"《梦游天姥吟留别》二","k":[{"f":"半壁见海日","b":"空中闻天鸡"},{"f":"千岩万转路不定","b":"迷花倚石忽已暝"},{"f":"熊咆龙吟殷岩泉","b":"栗深林兮惊层巅"},{"f":"云青青兮欲雨","b":"水澹澹兮生烟"},{"f":"列缺霹雳","b":"丘峦崩摧"},{"f":"洞天石扉","b":"訇然中开"},{"f":"青冥浩荡不见底","b":"日月照耀金银台"}],"a":"李白"},{"t":"《梦游天姥吟留别》三","k":[{"f":"霓为衣兮风为马","b":"云之君兮纷纷而来下"},{"f":"虎鼓瑟兮鸾回车","b":"仙之人兮列如麻"},{"f":"忽魂悸以魄动","b":"恍惊起而长嗟"},{"f":"惟觉时之枕席","b":"失向来之烟霞"},{"f":"世间行乐亦如此","b":"古来万事东流水"},{"f":"别君去兮何时还","b":"且放白鹿青崖间 须行即骑访名山"},{"f":"安能摧眉折腰事权贵","b":"使我不得开心颜"}],"a":"李白"},{"t":"《金陵酒肆留别》","k":[{"f":"风吹柳花满店香","b":"吴姬压酒唤客尝"},{"f":"金陵子弟来相送","b":"欲行不行各尽觞"},{"f":"请君试问东流水","b":"别意与之谁短长"}],"a":"李白"},{"t":"《清平调·云想衣裳花想容》","k":[{"f":"云想衣裳花想容","b":"春风拂槛露华浓"},{"f":"若非群玉山头见","b":"会向瑶台月下逢"}],"a":"李白"}]},{"t":"李白 4","k":[{"t":"《清平调·一枝红艳露凝香》","k":[{"f":"一枝红艳露凝香","b":"云雨巫山枉断肠"},{"f":"借问汉宫谁得似","b":"可怜飞燕倚新妆"}],"a":"李白"},{"t":"《清平调·名花倾国两相欢》","k":[{"f":"名花倾国两相欢","b":"常得君王带笑看"},{"f":"解释春风无限恨","b":"沉香亭北倚栏杆"}],"a":"李白"},{"t":"《行路难·金樽清酒斗十千》","k":[{"f":"金樽清酒斗十千","b":"玉盘珍羞直万钱"},{"f":"停杯投箸不能食","b":"拔剑四顾心茫然"},{"f":"欲渡黄河冰塞川","b":"将登太行雪满山"},{"f":"闲来垂钓碧溪上","b":"忽复乘舟梦日边"},{"f":"行路难","b":"行路难"},{"f":"多歧路","b":"今安在"},{"f":"长风破浪会有时","b":"直挂云帆济沧海"}],"a":"李白"},{"t":"《行路难·大道如青天》","k":[{"f":"大道如青天","b":"我独不得出"},{"f":"羞逐长安社中儿","b":"赤鸡白雉赌梨栗"},{"f":"弹剑作歌奏苦声","b":"曳裾王门不称情"},{"f":"淮阴市井笑韩信","b":"汉朝公卿忌贾生"},{"f":"君不见昔时燕家重郭隗","b":"拥篲折节无嫌猜"},{"f":"剧辛乐毅感恩分","b":"输肝剖胆效英才"},{"f":"昭王白骨萦蔓草","b":"谁人更扫黄金台"},{"f":"行路难","b":"归去来"}],"a":"李白"},{"t":"《行路难·有耳莫洗颍川水》","k":[{"f":"有耳莫洗颍川水","b":"有口莫食首阳蕨"},{"f":"含光混世贵无名","b":"何用孤高比云月"},{"f":"吾观自古贤达人","b":"功成不退皆殒身"},{"f":"子胥既弃吴江上","b":"屈原终投湘水滨"},{"f":"陆机雄才岂自保","b":"李斯税驾苦不早"},{"f":"华亭鹤唳讵可闻","b":"上蔡苍鹰何足道"},{"f":"君不见吴中张翰称达生","b":"秋风忽忆江东行"},{"f":"且乐生前一杯酒","b":"何须身后千载名"}],"a":"李白"},{"t":"《将进酒》一","k":[{"f":"君不见","b":"黄河之水天上来 奔流到海不复回"},{"f":"君不见","b":"高堂明镜悲白发 朝如青丝暮成雪"},{"f":"人生得意须尽欢","b":"莫使金樽空对月"},{"f":"天生我材必有用","b":"千金散尽还复来"},{"f":"烹羊宰牛且为乐","b":"会须一饮三百杯"},{"f":"岑夫子","b":"丹丘生"},{"f":"将进酒","b":"杯莫停"}],"a":"李白"},{"t":"《将进酒》二","k":[{"f":"与君歌一曲","b":"请君为我倾耳听"},{"f":"钟鼓馔玉不足贵","b":"但愿长醉不复醒"},{"f":"古来圣贤皆寂寞","b":"惟有饮者留其名"},{"f":"陈王昔时宴平乐","b":"斗酒十千恣欢谑"},{"f":"主人何为言少钱","b":"径须沽取对君酌"},{"f":"五花马","b":"千金裘"},{"f":"呼儿将出换美酒","b":"与尔同销万古愁"}],"a":"李白"}]}]}