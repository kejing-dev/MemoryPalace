{"id":"tang300-6","zh":"唐诗三百首 · 卷六","en":"300 Tang Poems · Vol. 6","tree":[{"t":"李商隐 3","k":[{"t":"《无题·凤尾香罗薄几重》","k":[{"f":"凤尾香罗薄几重","b":"碧文圆顶夜深缝"},{"f":"扇裁月魄羞难掩","b":"车走雷声语未通"},{"f":"曾是寂寥金烬暗","b":"断无消息石榴红"},{"f":"斑骓只系垂杨岸","b":"何处西南任好风"}],"a":"李商隐"},{"t":"《无题·相见时难别亦难》","k":[{"f":"相见时难别亦难","b":"东风无力百花残"},{"f":"春蚕到死丝方尽","b":"蜡炬成灰泪始干"},{"f":"晓镜但愁云鬓改","b":"夜吟应觉月光寒"},{"f":"蓬山此去无多路","b":"青鸟殷勤为探看"}],"a":"李商隐"},{"t":"《无题·来是空言去绝踪》","k":[{"f":"来是空言去绝踪","b":"月斜楼上五更钟"},{"f":"梦为远别啼难唤","b":"书被催成墨未浓"},{"f":"蜡照半笼金翡翠","b":"麝薰微度绣芙蓉"},{"f":"刘郎已恨蓬山远","b":"更隔蓬山一万重"}],"a":"李商隐"},{"t":"《无题·飒飒东风细雨来》","k":[{"f":"飒飒东风细雨来","b":"芙蓉塘外有轻雷"},{"f":"金蟾啮锁烧香入","b":"玉虎牵丝汲井回"},{"f":"贾氏窥帘韩掾少","b":"宓妃留枕魏王才"},{"f":"春心莫共花争发","b":"一寸相思一寸灰"}],"a":"李商隐"},{"t":"《无题·昨夜星辰昨夜风》","k":[{"f":"昨夜星辰昨夜风","b":"画楼西畔桂堂东"},{"f":"身无彩凤双飞翼","b":"心有灵犀一点通"},{"f":"隔座送钩春酒暖","b":"分曹射复蜡灯红"},{"f":"嗟余听鼓应官去","b":"走马兰台类转蓬"}],"a":"李商隐"},{"t":"《春雨》","k":[{"f":"怅卧新春白袷衣","b":"白门寥落意多违"},{"f":"红楼隔雨相望冷","b":"珠箔飘灯独自归"},{"f":"远路应悲春晼晚","b":"残霄犹得梦依稀"},{"f":"玉珰缄札何由达","b":"万里云罗一雁飞"}],"a":"李商隐"},{"t":"《筹笔驿》","k":[{"f":"猿鸟犹疑畏简书","b":"风云常为护储胥"},{"f":"徒令上将挥神笔","b":"终见降王走传车"},{"f":"管乐有才原不忝","b":"关张无命欲何如"},{"f":"他年锦里经祠庙","b":"梁父吟成恨有余"}],"a":"李商隐"}]},{"t":"李商隐 4","k":[{"t":"《锦瑟》","k":[{"f":"锦瑟无端五十弦","b":"一弦一柱思华年"},{"f":"庄生晓梦迷蝴蝶","b":"望帝春心托杜鹃"},{"f":"沧海月明珠有泪","b":"蓝田日暖玉生烟"},{"f":"此情可待成追忆","b":"只是当时已惘然"}],"a":"李商隐"},{"t":"《隋宫》","k":[{"f":"紫泉宫殿锁烟霞","b":"欲取芜城作帝家"},{"f":"玉玺不缘归日角","b":"锦帆应是到天涯"},{"f":"于今腐草无萤火","b":"终古垂杨有暮鸦"},{"f":"地下若逢陈后主","b":"岂宜重问后庭花"}],"a":"李商隐"},{"t":"《韩碑》一","k":[{"f":"元和天子神武姿","b":"彼何人哉轩与羲"},{"f":"誓将上雪列圣耻","b":"坐法宫中朝四夷"},{"f":"淮西有贼五十载","b":"封狼生䝙䝙生罴"},{"f":"不据山河据平地","b":"长戈利矛日可麾"},{"f":"帝得圣相相曰度","b":"贼斫不死神扶持"},{"f":"腰悬相印作都统","b":"阴风惨澹天王旗"},{"f":"愬武古通作牙爪","b":"仪曹外郎载笔随"}],"a":"李商隐"},{"t":"《韩碑》二","k":[{"f":"行军司马智且勇","b":"十四万众犹虎貔"},{"f":"入蔡缚贼献太庙","b":"功无与让恩不訾"},{"f":"帝曰汝度功第一","b":"汝从事愈宜为辞"},{"f":"愈拜稽首蹈且舞","b":"金石刻画臣能为"},{"f":"古者世称大手笔","b":"此事不系于职司"},{"f":"当仁自古有不让","b":"言讫屡颔天子颐"},{"f":"公退斋戒坐小阁","b":"濡染大笔何淋漓"}],"a":"李商隐"},{"t":"《韩碑》三","k":[{"f":"点