{"id":"tang300-9","zh":"唐诗三百首 · 卷九","en":"300 Tang Poems · Vol. 9","tree":[{"t":"杜甫 7","k":[{"t":"《兵车行》一","k":[{"f":"车辚辚","b":"马萧萧 行人弓箭各在腰"},{"f":"耶娘妻子走相送","b":"尘埃不见咸阳桥"},{"f":"牵衣顿足拦道哭","b":"哭声直上干云霄"},{"f":"道旁过者问行人","b":"行人但云点行频"},{"f":"或从十五北防河","b":"便至四十西营田"},{"f":"去时里正与裹头","b":"归来头白还戍边"}],"a":"杜甫"},{"t":"《兵车行》二","k":[{"f":"边庭流血成海水","b":"武皇开边意未已"},{"f":"君不闻","b":"汉家山东二百州 千村万落生荆杞"},{"f":"纵有健妇把锄犁","b":"禾生陇亩无东西"},{"f":"况复秦兵耐苦战","b":"被驱不异犬与鸡"},{"f":"长者虽有问","b":"役夫敢申恨"},{"f":"且如今年冬","b":"未休关西卒"}],"a":"杜甫"},{"t":"《兵车行》三","k":[{"f":"县官急索租","b":"租税从何出"},{"f":"信知生男恶","b":"反是生女好"},{"f":"生女犹得嫁比邻","b":"生男埋没随百草"},{"f":"君不见","b":"青海头 古来白骨无人收"},{"f":"新鬼烦冤旧鬼哭","b":"天阴雨湿声啾啾"}],"a":"杜甫"},{"t":"《丽人行》一","k":[{"f":"三月三日天气新","b":"长安水边多丽人"},{"f":"态浓意远淑且真","b":"肌理细腻骨肉匀"},{"f":"绣罗衣裳照暮春","b":"蹙金孔雀银麒麟"},{"f":"头上何所有","b":"翠微盍叶垂鬓唇"},{"f":"背后何所见","b":"珠压腰衱稳称身"},{"f":"就中云幕椒房亲","b":"赐名大国虢与秦"},{"f":"紫驼之峰出翠釜","b":"水精之盘行素鳞"}],"a":"杜甫"},{"t":"《丽人行》二","k":[{"f":"犀箸厌饫久未下","b":"鸾刀缕切空纷纶"},{"f":"黄门飞鞚不动尘","b":"御厨络绎送八珍"},{"f":"箫鼓哀吟感鬼神","b":"宾从杂遝实要津"},{"f":"后来鞍马何逡巡","b":"当轩下马入锦茵"},{"f":"杨花雪落覆白苹","b":"青鸟飞去衔红巾"},{"f":"炙手可热势绝伦","b":"慎莫近前丞相嗔"}],"a":"杜甫"},{"t":"《哀江头》一","k":[{"f":"少陵野老吞声哭","b":"春日潜行曲江曲"},{"f":"江头宫殿锁千门","b":"细柳新蒲为谁绿"},{"f":"忆昔霓旌下南苑","b":"苑中万物生颜色"},{"f":"昭阳殿里第一人","b":"同辇随君侍君侧"},{"f":"辇前才人带弓箭","b":"白马嚼啮黄金勒"}],"a":"杜甫"},{"t":"《哀江头》二","k":[{"f":"翻身向天仰射云","b":"一笑正坠双飞翼"},{"f":"明眸皓齿今何在","b":"血污游魂归不得"},{"f":"清渭东流剑阁深","b":"去住彼此无消息"},{"f":"人生有情泪沾臆","b":"江水江花岂终极"},{"f":"黄昏胡骑尘满城","b":"欲往城南望城北"}],"a":"杜甫"}]},{"t":"孟浩然 1","k":[{"t":"《宿建德江》","k":[{"f":"移舟泊烟渚","b":"日暮客愁新"},{"f":"野旷天低树","b":"江清月近人"}],"a":"孟浩然"},{"t":"《春晓》","k":[{"f":"春眠不觉晓","b":"处处闻啼鸟"},{"f":"夜来风雨声","b":"花落知多少"}],"a":"孟浩然"},{"t":"《宿桐庐江寄广陵旧游》","k":[{"f":"山暝闻猿愁","b":"沧江急夜流"},{"f":"风鸣两岸叶","b":"月照一孤舟"},{"f":"建德非吾土","b":"维扬忆旧游"},{"f":"还将两行泪","b":"遥寄海西头"}],"a":"孟浩然"},{"t":"《留别王维》","k":[{"f":"寂寂竟何待","b":"朝朝空自归"},{"f":"欲寻芳草去","b":"惜与故人违"},{"f":"当路谁相假","b":"知音世所稀"},{"f":"只应守寂寞","b":"还掩故园扉"}],"a":"孟浩然"},{"t":"《早寒有怀》","k":[{"f":"木落雁南度","b":"北风江上寒"},{"f":"我家襄水曲","b":"遥隔楚云端"},{"f":"乡泪客中尽","b":"孤帆天际看"},{"f":"迷津欲有问","b":"平海夕漫漫"}],"a":"孟浩然"},{"t":"《岁暮归南山》","k":[{"f":"北阙休上书","b":"南山归敝庐"},{"f":"不才明主弃","b":"多病故人疏"},{"f":"白发催年老","b":"青阳逼岁除"},{"f":"永怀愁不寐","b":"松月夜窗虚"}],"a":"孟浩然"},{"t":"《过故人庄》","k":[{"f":"故人具鸡黍","b":"邀我至田家"},{"f":"绿树村边合","b":"青山郭外斜"},{"f":"开轩面场圃","b":"把酒话桑麻"},{"f":"待到重阳日","b":"还来就菊花"}],"a":"孟浩然"},{"t":"《秦中寄远上人》","k":[{"f":"一丘常欲卧","b":"三径苦无资"},{"f":"北土非吾愿","b":"东林怀我师"},{"f":"黄金燃桂尽","b":"壮志逐年衰"},{"f":"日夕凉风至","b":"闻蝉但益悲"}],"a":"孟浩然"}]},{"t":"孟浩然 2","k":[{"t":"《望洞庭湖赠张丞相》","k":[{"f":"八月湖水平","b":"涵虚混太清"},{"f":"气蒸云梦泽","b":"波撼岳阳城"},{"f":"欲济无舟楫","b":"端居耻圣明"},{"f":"坐观垂钓者","b":"徒有羡鱼情"}],"a":"孟浩然"},{"t":"《与诸子登岘山》","k":[{"f":"人事有代谢","b":"往来成古今"},{"f":"江山留胜迹","b":"我辈复登临"},{"f":"水落鱼梁浅","b":"天寒梦泽深"},{"f":"羊公碑尚在","b":"读罢泪沾襟"}],"a":"孟浩然"},{"t":"《宴梅道士山房》","k":[{"f":"林卧愁春尽","b":"开轩览物华"},{"f":"忽逢青鸟使","b":"邀入赤松家"},{"f":"金灶初开火","b":"仙桃正发花"},{"f":"童颜若可驻","b":"何惜醉流霞"}],"a":"孟浩然"},{"t":"《秋登兰山寄张五》","k":[{"f":"北山白云里","b":"隐者自怡悦"},{"f":"相望试登高","b":"心随雁飞灭"},{"f":"愁因薄暮起","b":"兴是清秋发"},{"f":"时见归村人","b":"沙行渡头歇"},{"f":"天边树若荠","b":"江畔洲如月"},{"f":"何当载酒来","b":"共醉重阳节"}],"a":"孟浩然"},{"t":"《夏日南亭怀辛大》","k":[{"f":"山光忽西落","b":"池月渐东上"},{"f":"散发乘夕凉","b":"开轩卧闲敞"},{"f":"荷风送香气","b":"竹露滴清响"},{"f":"欲取鸣琴弹","b":"恨无知音赏"},{"f":"感此怀故人","b":"中宵劳梦想"}],"a":"孟浩然"},{"t":"《宿业师山房待丁大不至》","k":[{"f":"夕阳度西岭","b":"群壑倏已暝"},{"f":"松月生夜凉","b":"风泉满清听"},{"f":"樵人归欲尽","b":"烟鸟栖初定"},{"f":"之子期宿来","b":"孤琴候萝径"}],"a":"孟浩然"},{"t":"《夜归鹿门山歌》","k":[{"f":"山寺钟鸣昼已昏","b":"渔梁渡头争渡喧"},{"f":"人随沙岸向江村","b":"余亦乘舟归鹿门"},{"f":"鹿门月照开烟树","b":"忽到庞公栖隐处"},{"f":"岩扉松径长寂寥","b":"惟有幽人自来去"}],"a":"孟浩然"}]},{"t":"金昌绪","k":[{"t":"《春怨》","k":[{"f":"打起黄莺儿","b":"莫教枝上啼"},{"f":"啼时惊妾梦","b":"不得到辽西"}],"a":"金昌绪"}]}]}