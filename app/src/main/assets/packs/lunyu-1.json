{"id":"lunyu-1","zh":"论语名句","en":"The Analects","tree":[{"t":"学而","k":[{"f":"学而时习之","b":"不亦说乎"},{"f":"有朋自远方来","b":"不亦乐乎"},{"f":"人不知而不愠","b":"不亦君子乎"},{"f":"巧言令色","b":"鲜矣仁"},{"f":"吾日三省吾身","b":"为人谋而不忠乎"},{"f":"礼之用","b":"和为贵"},{"f":"与朋友交","b":"言而有信"},{"f":"不患人之不己知","b":"患不知人也"}]},{"t":"为政","k":[{"f":"吾十有五而志于学","b":"三十而立"},{"f":"四十而不惑","b":"五十而知天命"},{"f":"六十而耳顺","b":"七十而从心所欲 不逾矩"},{"f":"温故而知新","b":"可以为师矣"},{"f":"君子周而不比","b":"小人比而不周"},{"f":"学而不思则罔","b":"思而不学则殆"},{"f":"知之为知之","b":"不知为不知 是知也"},{"f":"人而无信","b":"不知其可也"}]},{"t":"八佾","k":[{"f":"是可忍也","b":"孰不可忍也"},{"f":"成事不说","b":"遂事不谏 既往不咎"}]},{"t":"里仁","k":[{"f":"朝闻道","b":"夕死可矣"},{"f":"君子喻于义","b":"小人喻于利"},{"f":"见贤思齐焉","b":"见不贤而内自省也"},{"f":"父母在","b":"不远游 游必有方"},{"f":"君子欲讷于言","b":"而敏于行"},{"f":"德不孤","b":"必有邻"}]},{"t":"公冶长","k":[{"f":"朽木不可雕也","b":"粪土之墙不可杇也"},{"f":"今吾于人也","b":"听其言而观其行"},{"f":"敏而好学","b":"不耻下问"},{"f":"老者安之","b":"朋友信之 少者怀之"}]},{"t":"雍也","k":[{"f":"知之者不如好之者","b":"好之者不如乐之者"},{"f":"质胜文则野","b":"文胜质则史"},{"f":"文质彬彬","b":"然后君子"},{"f":"知者乐水","b":"仁者乐山"}]},{"t":"述而","k":[{"f":"默而识之","b":"学而不厌 诲人不倦"},{"f":"不愤不启","b":"不悱不发"},{"f":"发愤忘食","b":"乐以忘忧"},{"f":"子不语","b":"怪力乱神"},{"f":"三人行","b":"必有我师焉"},{"f":"择其善者而从之","b":"其不善者而改之"},{"f":"君子坦荡荡","b":"小人长戚戚"}]},{"t":"泰伯","k":[{"f":"士不可以不弘毅","b":"任重而道远"},{"f":"不在其位","b":"不谋其政"}]},{"t":"子罕","k":[{"f":"逝者如斯夫","b":"不舍昼夜"},{"f":"后生可畏","b":"焉知来者之不如今也"},{"f":"三军可夺帅也","b":"匹夫不可夺志也"},{"f":"岁寒","b":"然后知松柏之后凋也"},{"f":"知者不惑","b":"仁者不忧 勇者不惧"}]},{"t":"先进","k":[{"f":"未知生","b":"焉知死"}]},{"t":"颜渊","k":[{"f":"非礼勿视","b":"非礼勿听"},{"f":"非礼勿言","b":"非礼勿动"},{"f":"己所不欲","b":"勿施于人"},{"f":"四海之内","b":"皆兄弟也"},{"f":"君子成人之美","b":"不成人之恶"}]},{"t":"子路","k":[{"f":"名不正则言不顺","b":"言不顺则事不成"},{"f":"其身正 不令而行","b":"其身不正 虽令不从"},{"f":"欲速则不达","b":"见小利则大事不成"},{"f":"君子和而不同","b":"小人同而不和"}]},{"t":"宪问","k":[{"f":"以直报怨","b":"以德报德"},{"f":"君子耻其言","b":"而过其行"}]},{"t":"卫灵公","k":[{"f":"工欲善其事","b":"必先利其器"},{"f":"人无远虑","b":"必有近忧"},{"f":"躬自厚而薄责于人","b":"则远怨矣"},{"f":"小不忍","b":"则乱大谋"},{"f":"过而不改","b":"是谓过矣"},{"f":"当仁","b":"不让于师"},{"f":"道不同","b":"不相为谋"}]},{"t":"季氏","k":[{"f":"不患寡而患不均","b":"不患贫而患不安"},{"f":"益者三友 损者三友","b":"友直 友谅 友多闻"}]},{"t":"阳货","k":[{"f":"性相近也","b":"习相远也"}]},{"t":"微子","k":[{"f":"往者不可谏","b":"来者犹可追"}]},{"t":"子张","k":[{"f":"博学而笃志","b":"切问而近思"},{"f":"仕而优则学","b":"学而优则仕"}]},{"t":"尧曰","k":[{"f":"不知命","b":"无以为君子也"}]}]}