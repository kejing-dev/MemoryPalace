{"id":"tang300-1","zh":"唐诗三百首 · 卷一","en":"300 Tang Poems · Vol. 1","tree":[{"t":"元稹","k":[{"t":"《行宫》","k":[{"f":"寥落古行宫","b":"宫花寂寞红"},{"f":"白头宫女在","b":"闲坐说玄宗"}],"a":"元稹"},{"t":"《遣悲怀三首·其一》","k":[{"f":"谢公最小偏怜女","b":"自嫁黔娄百事乖"},{"f":"顾我无衣搜荩箧","b":"泥他沽酒拔金钗"},{"f":"野蔬充膳甘长藿","b":"落叶添薪仰古槐"},{"f":"今日俸钱过十万","b":"与君营奠复营斋"}],"a":"元稹"},{"t":"《遣悲怀三首·其二》","k":[{"f":"昔日戏言身后事","b":"今朝都到眼前来"},{"f":"衣裳已施行看尽","b":"针线犹存未忍开"},{"f":"尚想旧情怜婢仆","b":"也曾因梦送钱财"},{"f":"诚知此恨人人有","b":"贫贱夫妻百事哀"}],"a":"元稹"},{"t":"《遣悲怀三首·其三》","k":[{"f":"闲坐悲君亦自悲","b":"百年都是几多时"},{"f":"邓攸无子寻知命","b":"潘岳悼亡犹费词"},{"f":"同穴窅冥何所望","b":"他生缘会更难期"},{"f":"惟将终夜常开眼","b":"报答平生未展眉"}],"a":"元稹"}]},{"t":"王之涣","k":[{"t":"《登鹳雀楼》","k":[{"f":"白日依山尽","b":"黄河入海流"},{"f":"欲穷千里目","b":"更上一层楼"}],"a":"王之涣"},{"t":"《凉州词》","k":[{"f":"黄河远上白云间","b":"一片孤城万仞山"},{"f":"羌笛何须怨杨柳","b":"春风不度玉门关"}],"a":"王之涣"}]},{"t":"王建","k":[{"t":"《新嫁娘词》","k":[{"f":"三日入厨下","b":"洗手作羹汤"},{"f":"未谙姑食性","b":"先遣小姑尝"}],"a":"王建"}]},{"t":"王维 1","k":[{"t":"《相思》","k":[{"f":"红豆生南国","b":"春来发几枝"},{"f":"愿君多采撷","b":"此物最相思"}],"a":"王维"},{"t":"《杂诗》","k":[{"f":"君自故乡来","b":"应知故乡事"},{"f":"来日绮窗前","b":"寒梅著花未"}],"a":"王维"},{"t":"《鹿柴》","k":[{"f":"空山不见人","b":"但闻人语响"},{"f":"返景入深林","b":"复照青苔上"}],"a":"王维"},{"t":"《竹里馆》","k":[{"f":"独坐幽篁里","b":"弹琴复长啸"},{"f":"深林人不知","b":"明月来相照"}],"a":"王维"},{"t":"《山中送别》","k":[{"f":"山中相送罢","b":"日暮掩柴扉"},{"f":"春草明年绿","b":"王孙归不归"}],"a":"王维"},{"t":"《九月九日忆山东兄弟》","k":[{"f":"独在异乡为异客","b":"每逢佳节倍思亲"},{"f":"遥知兄弟登高处","b":"遍插茱萸少一人"}],"a":"王维"},{"t":"《送梓州李使君》","k":[{"f":"万壑树参天","b":"千山响杜鹃"},{"f":"山中一夜雨","b":"树杪百重泉"},{"f":"汉女输橦布","b":"巴人讼芋田"},{"f":"文翁翻教授","b":"不敢倚先贤"}],"a":"王维"},{"t":"《汉江临眺》","k":[{"f":"楚塞三湘接","b":"荆门九派通"},{"f":"江流天地外","b":"山色有无中"},{"f":"郡邑浮前浦","b":"波澜动远空"},{"f":"襄阳好风日","b":"留醉与山翁"}],"a":"王维"}]},{"t":"王维 2","k":[{"t":"《终南别业》","k":[{"f":"中岁颇好道","b":"晚家南山陲"},{"f":"兴来每独往","b":"胜事空自知"},{"f":"行到水穷处","b":"坐看云起时"},{"f":"偶然值林叟","b":"谈笑无还期"}],"a":"王维"},{"t":"《终南山》","k":[{"f":"太乙近天都","b":"连山接海隅"},{"f":"白云回望合","b":"青霭入看无"},{"f":"分野中峰变","b":"阴晴众壑殊"},{"f":"欲投人处宿","b":"隔水问樵夫"}],"a":"王维"},{"t":