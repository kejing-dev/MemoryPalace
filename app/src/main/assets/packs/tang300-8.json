{"id":"tang300-8","zh":"唐诗三百首 · 卷八","en":"300 Tang Poems · Vol. 8","tree":[{"t":"杜甫 5","k":[{"t":"《古柏行》一","k":[{"f":"孔明庙前有老柏","b":"柯如青铜根如石"},{"f":"霜皮溜雨四十围","b":"黛色参天二千尺"},{"f":"君臣已与时际会","b":"树木犹为人爱惜"},{"f":"云来气接巫峡长","b":"月出寒通雪山白"},{"f":"忆昨路绕锦亭东","b":"先主武侯同閟宫"},{"f":"崔嵬枝干郊原古","b":"窈窕丹青户牖空"}],"a":"杜甫"},{"t":"《古柏行》二","k":[{"f":"落落盘踞虽得地","b":"冥冥孤高多烈风"},{"f":"扶持自是神明力","b":"正直原因造化工"},{"f":"大厦如倾要梁栋","b":"万牛回首丘山重"},{"f":"不露文章世已惊","b":"未辞翦伐谁能送"},{"f":"苦心岂免容蝼蚁","b":"香叶终经宿鸾凤"},{"f":"志士幽人莫怨嗟","b":"古来材大难为用"}],"a":"杜甫"},{"t":"《观公孙大娘弟子舞剑器行》一","k":[{"f":"昔有佳人公孙氏","b":"一舞剑器动四方"},{"f":"观者如山色沮丧","b":"天地为之久低昂"},{"f":"霍如羿射九日落","b":"矫如群帝骖龙翔"},{"f":"来如雷霆收震怒","b":"罢如江海凝清光"},{"f":"绛唇珠袖两寂寞","b":"晚有弟子传芬芳"},{"f":"临颍美人在白帝","b":"妙舞此曲神扬扬"},{"f":"与余问答既有以","b":"感时抚事增惋伤"}],"a":"杜甫"},{"t":"《观公孙大娘弟子舞剑器行》二","k":[{"f":"先帝侍女八千人","b":"公孙剑器初第一"},{"f":"五十年间似反掌","b":"风尘澒洞昏王室"},{"f":"梨园弟子散如烟","b":"女乐余姿映寒日"},{"f":"金粟堆南木已拱","b":"瞿唐石城草萧瑟"},{"f":"玳筵急管曲复终","b":"乐极哀来月东出"},{"f":"老夫不知其所往","b":"足茧荒山转愁疾"}],"a":"杜甫"},{"t":"《韦讽录事宅观曹将军画马》一","k":[{"f":"国初已来画鞍马","b":"神妙独数江都王"},{"f":"将军得名三十载","b":"人间又见真乘黄"},{"f":"曾貌先帝照夜白","b":"龙池十日飞霹雳"},{"f":"内府殷红玛瑙盘","b":"婕妤传诏才人索"},{"f":"盘赐将军拜舞归","b":"轻纨细绮相追飞"},{"f":"贵戚权门得笔迹","b":"始觉屏障生光辉"}],"a":"杜甫"},{"t":"《韦讽录事宅观曹将军画马》二","k":[{"f":"昔日太宗拳毛䯄","b":"近时郭家狮子花"},{"f":"今之新图有二马","b":"复令识者久叹嗟"},{"f":"此皆骑战一敌万","b":"缟素漠漠开风沙"},{"f":"其余七匹亦殊绝","b":"迥若寒空动烟雪"},{"f":"霜蹄蹴踏长楸间","b":"马官厮养森成列"},{"f":"可怜九马争神骏","b":"顾视清高气深稳"}],"a":"杜甫"},{"t":"《韦讽录事宅观曹将军画马》三","k":[{"f":"借问苦心爱者谁","b":"后有韦讽前支遁"},{"f":"忆昔巡幸新丰宫","b":"翠华拂天来向东"},{"f":"腾骧磊落三万匹","b":"皆与此图筋骨同"},{"f":"自从献宝朝河宗","b":"无复射蛟江水中"},{"f":"君不见金粟堆前松柏里","b":"龙媒去尽鸟呼风"}],"a":"杜甫"}]},{"t":"杜甫 6","k":[{"t":"《丹青引赠曹霸将军》一","k":[{"f":"将军魏武之子孙","b":"于今为庶为清门"},{"f":"英雄割据虽已矣","b":"文采风流今尚存"},{"f":"学书初学卫夫人","b":"但恨无过王右军"},{"f":"丹青不知老将至","b":"富贵于我如浮云"},{"f":"开元之中常引见","b":"承恩数上南薰殿"},{"f":"凌烟功臣少颜色","b":"将军下笔开生面"},{"f":"良相头上进贤冠","b":"猛将腰间大羽箭"}],"a":"杜甫"},{"t":"《丹青引赠曹霸将军》二","k":[{"f":"褒公鄂公毛发动","b":"英姿飒爽来酣战"},{"f":"先帝御马五花骢","b":"画工如山貌不同"},{"f":"是日牵来赤墀下","b":"迥立阊阖生长风"},{"f":"诏谓将军拂绢素","b":"意匠惨澹经营中"},{"f":"斯须九重真龙出","b":"一洗万古凡马空"},{"f":"玉花却在御榻上","b":"榻上庭前屹相向"},{"f":"至尊含笑催赐金","b":"圉人太仆皆惆怅"}],"a":"杜甫"},{"t":"《丹青引赠曹霸将军》三","k":[{"f":"弟子韩干早入室","b":"亦能画马穷殊相"},{"f":"干惟画肉不画骨","b":"忍使骅骝气凋丧"},{"f":"将军画善盖有神","b":"必逢佳士亦写真"},{"f":"即今漂泊干戈际","b":"屡貌寻常行路人"},{"f":"途穷反遭俗眼白","b":"世上未有如公贫"},{"f":"但看古来盛名下","b":"终日坎𡒄缠其身"}],"a":"杜甫"},{"t":"《寄韩谏议》一","k":[{"f":"今我不乐思岳阳","b":"身欲奋飞病在床"},{"f":"美人娟娟隔秋水","b":"濯足洞庭望八荒"},{"f":"鸿飞冥冥日月白","b":"青枫叶赤天雨霜"},{"f":"玉京群帝集北斗","b":"或骑麒麟翳凤凰"},{"f":"芙蓉旌旗烟雾落","b":"影动倒景摇潇湘"},{"f":"星宫之君醉琼浆","b":"羽人稀少不在旁"}],"a":"杜甫"},{"t":"《寄韩谏议》二","k":[{"f":"似闻昨者赤松子","b":"恐是汉代韩张良"},{"f":"昔随刘氏定长安","b":"帷幄未改神惨伤"},{"f":"国家成败吾岂敢","b":"色难腥腐餐枫香"},{"f":"周南留滞古所惜","b":"南极老人应寿昌"},{"f":"美人胡为隔秋水","b":"焉得置之贡玉堂"}],"a":"杜甫"},{"t":"《哀王孙》一","k":[{"f":"长安城头头白乌","b":"夜飞延秋门上呼"},{"f":"又向人家啄大屋","b":"屋底达官走避胡"},{"f":"金鞭断折九马死","b":"骨肉不得同驰驱"},{"f":"腰下宝玦青珊瑚","b":"可怜王孙泣路隅"},{"f":"问之不肯道姓名","b":"但道困苦乞为奴"},{"f":"已经百日窜荆棘","b":"身上无有完肌肤"},{"f":"高帝子孙尽隆准","b":"龙种自与常人殊"}],"a":"杜甫"},{"t":"《哀王孙》二","k":[{"f":"豺狼在邑龙在野","b":"王孙善保千金躯"},{"f":"不敢长语临交衢","b":"且为王孙立斯须"},{"f":"昨夜东风吹血腥","b":"东来橐驼满旧都"},{"f":"朔方健儿好身手","b":"昔何勇锐今何愚"},{"f":"窃闻天子已传位","b":"圣德北服南单于"},{"f":"花门剺面请雪耻","b":"慎勿出口他人狙"},{"f":"哀哉王孙慎勿疏","b":"五陵佳气无时无"}],"a":"杜甫"}]}]}