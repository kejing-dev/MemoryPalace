{"id":"tang300-3","zh":"唐诗三百首 · 卷三","en":"300 Tang Poems · Vol. 3","tree":[{"t":"白居易 3","k":[{"t":"《琵琶行》一","k":[{"f":"浔阳江头夜送客","b":"枫叶荻花秋瑟瑟"},{"f":"主人下马客在船","b":"举酒欲饮无管弦"},{"f":"醉不成欢惨将别","b":"别时茫茫江浸月"},{"f":"忽闻水上琵琶声","b":"主人忘归客不发"},{"f":"寻声暗问弹者谁","b":"琵琶声停欲语迟"},{"f":"移船相近邀相见","b":"添酒回灯重开宴"},{"f":"千呼万唤始出来","b":"犹抱琵琶半遮面"},{"f":"转轴拨弦三两声","b":"未成曲调先有情"}],"a":"白居易"},{"t":"《琵琶行》二","k":[{"f":"弦弦掩抑声声思","b":"似诉平生不得志"},{"f":"低眉信手续续弹","b":"说尽心中无限事"},{"f":"轻拢慢捻抹复挑","b":"初为霓裳后六幺"},{"f":"大弦嘈嘈如急雨","b":"小弦切切如私语"},{"f":"嘈嘈切切错杂弹","b":"大珠小珠落玉盘"},{"f":"间关莺语花底滑","b":"幽咽泉流冰下难"},{"f":"冰泉冷涩弦凝绝","b":"凝绝不通声暂歇"},{"f":"别有幽愁暗恨生","b":"此时无声胜有声"}],"a":"白居易"},{"t":"《琵琶行》三","k":[{"f":"银瓶乍破水浆迸","b":"铁骑突出刀枪鸣"},{"f":"曲终收拨当心画","b":"四弦一声如裂帛"},{"f":"东船西舫悄无言","b":"唯见江心秋月白"},{"f":"沉吟放拨插弦中","b":"整顿衣裳起敛容"},{"f":"自言本是京城女","b":"家在虾蟆陵下住"},{"f":"十三学得琵琶成","b":"名属教坊第一部"},{"f":"曲罢曾教善才服","b":"妆成每被秋娘妒"}],"a":"白居易"},{"t":"《琵琶行》四","k":[{"f":"五陵年少争缠头","b":"一曲红绡不知数"},{"f":"钿头银篦击节碎","b":"血色罗裙翻酒污"},{"f":"今年欢笑复明年","b":"秋月春风等闲度"},{"f":"弟走从军阿姨死","b":"暮去朝来颜色故"},{"f":"门前冷落鞍马稀","b":"老大嫁作商人妇"},{"f":"商人重利轻别离","b":"前月浮梁买茶去"},{"f":"去来江口守空船","b":"绕船月明江水寒"}],"a":"白居易"},{"t":"《琵琶行》五","k":[{"f":"夜深忽梦少年事","b":"梦啼妆泪红阑干"},{"f":"我闻琵琶已叹息","b":"又闻此语重唧唧"},{"f":"同是天涯沦落人","b":"相逢何必曾相识"},{"f":"我从去年辞帝京","b":"谪居卧病浔阳城"},{"f":"浔阳地僻无音乐","b":"终岁不闻丝竹声"},{"f":"住近湓江地低湿","b":"黄芦苦竹绕宅生"},{"f":"其间旦暮闻何物","b":"杜鹃啼血猿哀鸣"}],"a":"白居易"},{"t":"《琵琶行》六","k":[{"f":"春江花朝秋月夜","b":"往往取酒还独倾"},{"f":"岂无山歌与村笛","b":"呕哑嘲哳难为听"},{"f":"今夜闻君琵琶语","b":"如听仙乐耳暂明"},{"f":"莫辞更坐弹一曲","b":"为君翻作琵琶行"},{"f":"感我此言良久立","b":"却坐促弦弦转急"},{"f":"凄凄不似向前声","b":"满座重闻皆掩泣"},{"f":"座中泣下谁最多","b":"江州司马青衫湿"}],"a":"白居易"}]},{"t":"西鄙人","k":[{"t":"《哥舒歌》","k":[{"f":"北斗七星高","b":"哥舒夜带刀"},{"f":"至今窥牧马","b":"不敢过临洮"}],"a":"西鄙人"}]},{"t":"李白 1","k":[{"t":"《静夜思》","k":[{"f":"床前明月光","b":"疑是地上霜"},{"f":"举头望明月","b":"低头思故乡"}],"a":"李白"},{"t":"《怨情》","k":[{"f":"美人卷珠帘","b":"深坐颦蛾眉"},{"f":"但见泪痕湿","b":"不知心恨谁"}],"a":"李白"},{"t":"《黄鹤楼送孟浩然之广陵》","k":[{"f":"故人西辞黄鹤楼","b":"烟花三月下扬州"},{"f":"孤帆远影碧空尽","b":"唯见长江天际流"}],"a":"李白"},{"t":"《早发白帝城》","k":[{"f":"朝辞白帝彩云间","b":"千里江陵一日还"},{"f":"两岸猿声啼不住","b":"轻舟已过万重山"}],"a":"李白"},{"t":"《听蜀僧浚弹琴》","k":[{"f":"蜀僧抱绿绮","b":"西下峨眉峰"},{"f":"为我一挥手","b":"如听万壑松"},{"f":"客心洗流水","b":"余响入霜钟"},{"f":"不觉碧山暮","b":"秋云暗几重"}],"a":"李白"},{"t":"《夜泊牛渚怀古》","k":[{"f":"牛渚西江夜","b":"青天无片云"},{"f":"登舟望秋月","b":"空忆谢将军"},{"f":"余亦能高咏","b":"斯人不可闻"},{"f":"明朝挂帆席","b":"枫叶落纷纷"}],"a":"李白"},{"t":"《赠孟浩然》","k":[{"f":"吾爱孟夫子","b":"风流天下闻"},{"f":"红颜弃轩冕","b":"白首卧松云"},{"f":"醉月频中圣","b":"迷花不事君"},{"f":"高山安可仰","b":"徒此揖清芬"}],"a":"李白"}]},{"t":"李白 2","k":[{"t":"《渡荆门送别》","k":[{"f":"渡远荆门外","b":"来从楚国游"},{"f":"山随平野尽","b":"江入大荒流"},{"f":"月下飞天镜","b":"云生结海楼"},{"f":"仍怜故乡水","b":"万里送行舟"}],"a":"李白"},{"t":"《送友人》","k":[{"f":"青山横北郭","b":"白水绕东城"},{"f":"此地一为别","b":"孤蓬万里征"},{"f":"浮云游子意","b":"落日故人情"},{"f":"挥手自兹去","b":"萧萧班马鸣"}],"a":"李白"},{"t":"《登金陵凤凰台》","k":[{"f":"凤凰台上凤凰游","b":"凤去台空江自流"},{"f":"吴宫花草埋幽径","b":"晋代衣冠成古丘"},{"f":"三山半落青天外","b":"二水中分白鹭洲"},{"f":"总为浮云能蔽日","b":"长安不见使人愁"}],"a":"李白"},{"t":"《下终南山过斛斯山人宿置酒》","k":[{"f":"暮从碧山下","b":"山月随人归"},{"f":"却顾所来径","b":"苍苍横翠微"},{"f":"相携及田家","b":"童稚开荆扉"},{"f":"绿竹入幽径","b":"青萝拂行衣"},{"f":"欢言得所憩","b":"美酒聊共挥"},{"f":"长歌吟松风","b":"曲尽河星稀"},{"f":"我醉君复乐","b":"陶然共忘机"}],"a":"李白"},{"t":"《月下独酌四首·其一》","k":[{"f":"花间一壶酒","b":"独酌无相亲"},{"f":"举杯邀明月","b":"对影成三人"},{"f":"月既不解饮","b":"影徒随我身"},{"f":"暂伴月将影","b":"行乐须及春"},{"f":"我歌月徘徊","b":"我舞影零乱"},{"f":"醒时同交欢","b":"醉后各分散"},{"f":"永结无情游","b":"相期邈云汉"}],"a":"李白"},{"t":"《春思》","k":[{"f":"燕草如碧丝","b":"秦桑低绿枝"},{"f":"当君怀归日","b":"是妾断肠时"},{"f":"春风不相识","b":"何事入罗帏"}],"a":"李白"},{"t":"《宣州谢脁楼饯别校书叔云》","k":[{"f":"弃我去者","b":"昨日之日不可留"},{"f":"乱我心者","b":"今日之日多烦忧"},{"f":"长风万里送秋雁","b":"对此可以酣高楼"},{"f":"蓬莱文章建安骨","b":"中间小谢又清发"},{"f":"俱怀逸兴壮思飞","b":"欲上青天揽明月"},{"f":"抽刀断水水更流","b":"举杯消愁愁更愁"},{"f":"人生在世不称意","b":"明朝散发弄扁舟"}],"a":"李白"}]}]}