{"id":"math-1","zh":"常用数学公式","en":"Math Formulas","tree":[{"t":"代数","k":[{"f":"完全平方公式","b":"(a ± b)² = a² ± 2ab + b²"},{"f":"平方差公式","b":"a² − b² = (a + b)(a − b)"},{"f":"立方和公式","b":"a³ + b³ = (a + b)(a² − ab + b²)"},{"f":"立方差公式","b":"a³ − b³ = (a − b)(a² + ab + b²)"},{"f":"一元二次方程求根公式","b":"x = [−b ± √(b² − 4ac)] / 2a"},{"f":"判别式","b":"Δ = b² − 4ac"},{"f":"韦达定理","b":"x₁ + x₂ = −b/a，x₁x₂ = c/a"},{"f":"同底数幂相乘","b":"aᵐ · aⁿ = aᵐ⁺ⁿ"}]},{"t":"指数与对数","k":[{"f":"幂的乘方","b":"(aᵐ)ⁿ = aᵐⁿ"},{"f":"负指数","b":"a⁻ⁿ = 1/aⁿ（a ≠ 0）"},{"f":"对数定义","b":"aˣ = N ⇔ x = logₐN"},{"f":"积的对数","b":"logₐ(MN) = logₐM + logₐN"},{"f":"商的对数","b":"logₐ(M/N) = logₐM − logₐN"},{"f":"幂的对数","b":"logₐ(Mⁿ) = n·logₐM"},{"f":"换底公式","b":"logₐb = lg b / lg a"}]},{"t":"平面图形","k":[{"f":"三角形面积","b":"S = ½ × 底 × 高"},{"f":"海伦公式","b":"S = √[p(p−a)(p−b)(p−c)]，p 为半周长"},{"f":"梯形面积","b":"S = ½ (上底 + 下底) × 高"},{"f":"平行四边形面积","b":"S = 底 × 高"},{"f":"圆的周长","b":"C = 2πr"},{"f":"圆的面积","b":"S = πr²"},{"f":"扇形面积","b":"S = ½ l r = (n/360) πr²"},{"f":"勾股定理","b":"a² + b² = c²"}]},{"t":"立体图形","k":[{"f":"长方体体积","b":"V = 长 × 宽 × 高"},{"f":"圆柱体积","b":"V = πr²h"},{"f":"圆锥体积","b":"V = ⅓ πr²h"},{"f":"球的体积","b":"V = ⁴⁄₃ πr³"},{"f":"球的表面积","b":"S = 4πr²"},{"f":"圆柱侧面积","b":"S = 2πrh"},{"f":"棱锥体积","b":"V = ⅓ Sh"},{"f":"欧拉多面体公式","b":"V − E + F = 2"}]},{"t":"三角函数","k":[{"f":"平方关系","b":"sin²α + cos²α = 1"},{"f":"商数关系","b":"tan α = sin α / cos α"},{"f":"两角和的正弦","b":"sin(α+β) = sinα cosβ + cosα sinβ"},{"f":"两角和的余弦","b":"cos(α+β) = cosα cosβ − sinα sinβ"},{"f":"二倍角正弦","b":"sin 2α = 2 sinα cosα"},{"f":"二倍角余弦","b":"cos 2α = cos²α − sin²α"},{"f":"正弦定理","b":"a/sinA = b/sinB = c/sinC = 2R"},{"f":"余弦定理","b":"c² = a² + b² − 2ab cosC"}]},{"t":"数列与组合","k":[{"f":"等差数列通项","b":"aₙ = a₁ + (n−1)d"},{"f":"等差数列求和","b":"Sₙ = n(a₁ + aₙ)/2"},{"f":"等比数列通项","b":"aₙ = a₁qⁿ⁻¹"},{"f":"等比数列求和","b":"Sₙ = a₁(1 − qⁿ)/(1 − q)，q ≠ 1"},{"f":"排列数","b":"Aₙᵐ = n!/(n−m)!"},{"f":"组合数","b":"Cₙᵐ = n!/[m!(n−m)!]"},{"f":"二项式定理通项","b":"Tₖ₊₁ = Cₙᵏ aⁿ⁻ᵏ bᵏ"},{"f":"1 + 2 + … + n","b":"n(n+1)/2"}]},{"t":"解析几何","k":[{"f":"两点间距离","b":"d = √[(x₂−x₁)² + (y₂−y₁)²]"},{"f":"直线斜率","b":"k = (y₂ − y₁)/(x₂ − x₁)"},{"f":"点到直线距离","b":"d = |Ax₀ + By₀ + C| / √(A² + B²)"},{"f":"圆的标准方程","b":"(x−a)² + (y−b)² = r²"},{"f":"椭圆标准方程","b":"x²/a² + y²/b² = 1（a > b > 0）"},{"f":"双曲线标准方程","b":"x²/a² − y²/b² = 1"},{"f":"抛物线标准方程","b":"y² = 2px"},{"f":"中点坐标","b":"((x₁+x₂)/2, (y₁+y₂)/2)"}]},{"t":"微积分与概率","k":[{"f":"(xⁿ)′","b":"n xⁿ⁻¹"},{"f":"(sin x)′","b":"cos x"},{"f":"(eˣ)′","b":"eˣ"},{"f":"(ln x)′","b":"1/x"},{"f":"乘积求导","b":"(uv)′ = u′v + uv′"},{"f":"牛顿–莱布尼茨公式","b":"∫ₐᵇ f(x)dx = F(b) − F(a)"},{"f":"古典概型","b":"P(A) = A 包含的基本事件数 / 基本事件总数"},{"f":"条件概率","b":"P(B|A) = P(AB) / P(A)"}]}]}