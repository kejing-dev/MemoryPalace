{"id":"tang300-5","zh":"唐诗三百首 · 卷五","en":"300 Tang Poems · Vol. 5","tree":[{"t":"李白 5","k":[{"t":"《玉阶怨》","k":[{"f":"玉阶生白露","b":"夜久侵罗袜"},{"f":"却下水晶帘","b":"玲珑望秋月"}],"a":"李白"},{"t":"《长相思·其一》","k":[{"f":"长相思","b":"在长安"},{"f":"络纬秋啼金井阑","b":"微霜凄凄簟色寒"},{"f":"孤灯不明思欲绝","b":"卷帷望月空长叹"},{"f":"美人如花隔云端","b":"上有青冥之长天 下有渌水之波澜"},{"f":"天长路远魂飞苦","b":"梦魂不到关山难"},{"f":"长相思","b":"摧心肝"}],"a":"李白"},{"t":"《长相思·其二》","k":[{"f":"日色欲尽花含烟","b":"月明欲素愁不眠"},{"f":"赵瑟初停凤凰柱","b":"蜀琴欲奏鸳鸯弦"},{"f":"此曲有意无人传","b":"愿随春风寄燕然"},{"f":"忆君迢迢隔青天","b":"昔日横波目 今作流泪泉"},{"f":"不信妾断肠","b":"归来看取明镜前"}],"a":"李白"},{"t":"《长干行·其一》一","k":[{"f":"妾发初覆额","b":"折花门前剧"},{"f":"郎骑竹马来","b":"绕床弄青梅"},{"f":"同居长干里","b":"两小无嫌猜"},{"f":"十四为君妇","b":"羞颜未尝开"},{"f":"低头向暗壁","b":"千唤不一回"},{"f":"十五始展眉","b":"愿同尘与灰"},{"f":"常存抱柱信","b":"岂上望夫台"},{"f":"十六君远行","b":"瞿塘滟滪堆"}],"a":"李白"},{"t":"《长干行·其一》二","k":[{"f":"五月不可触","b":"猿声天上哀"},{"f":"门前迟行迹","b":"一一生绿苔"},{"f":"苔深不能扫","b":"落叶秋风早"},{"f":"八月蝴蝶来","b":"双飞西园草"},{"f":"感此伤妾心","b":"坐愁红颜老"},{"f":"早晚下三巴","b":"预将书报家"},{"f":"相迎不道远","b":"直至长风沙"}],"a":"李白"},{"t":"《蜀道难》一","k":[{"f":"噫吁嚱","b":"危乎高哉"},{"f":"蜀道之难","b":"难于上青天"},{"f":"蚕丛及鱼凫","b":"开国何茫然"},{"f":"尔来四万八千岁","b":"不与秦塞通人烟"},{"f":"西当太白有鸟道","b":"可以横绝峨眉巅"},{"f":"地崩山摧壮士死","b":"然后天梯石栈相钩连"},{"f":"上有六龙回日之高标","b":"下有冲波逆折之回川"},{"f":"黄鹤之飞尚不得过","b":"猿猱欲度愁攀援"}],"a":"李白"},{"t":"《蜀道难》二","k":[{"f":"青泥何盘盘","b":"百步九折萦岩峦"},{"f":"扪参历井仰胁息","b":"以手抚膺坐长叹"},{"f":"问君西游何时还","b":"畏途巉岩不可攀"},{"f":"但见悲鸟号古木","b":"雄飞雌从绕林间"},{"f":"又闻子规啼夜月","b":"愁空山"},{"f":"蜀道之难","b":"难于上青天 使人听此凋朱颜"},{"f":"连峰去天不盈尺","b":"枯松倒挂倚绝壁"},{"f":"飞湍瀑流争喧豗","b":"砯崖转石万壑雷"}],"a":"李白"}]},{"t":"李白 6","k":[{"t":"《蜀道难》三","k":[{"f":"其险也如此","b":"嗟尔远道之人胡为乎来哉"},{"f":"剑阁峥嵘而崔嵬","b":"一夫当关 万夫莫开"},{"f":"所守或匪亲","b":"化为狼与豺"},{"f":"朝避猛虎","b":"夕避长蛇"},{"f":"磨牙吮血","b":"杀人如麻"},{"f":"锦城虽云乐","b":"不如早还家"},{"f":"蜀道之难","b":"难于上青天 侧身西望长咨嗟"}],"a":"李白"},{"t":"《子夜吴歌·春歌》","k":[{"f":"秦地罗敷女","b":"采桑绿水边"},{"f":"素手青条上","b":"红妆白日鲜"},{"f":"蚕饥妾欲去","b":"五马莫留连"}],"a":"李白"},{"t":"《子夜吴歌·夏歌》","k":[{"f":"镜湖三百里","b":"菡萏发荷花"},{"f":"五月西施采","b":"人看隘若耶"},{"f":"回舟不待月","b":"归去越王家"}],"a":"李白"},{"t":"《子夜吴歌·秋歌》","k":[{"f":"长安一片月","b":"万户捣衣声"},{"f":"秋风吹不尽","b":"总是玉关情"},{"f":"何日平胡虏","b":"良人罢远征"}],"a":"李白"},{"t":"《子夜吴歌·冬歌》","k":[{"f":"明朝驿使发","b":"一夜絮征袍"},{"f":"素手抽针冷","b":"那堪把剪刀"},{"f":"裁缝寄远道","b":"几日到临洮"}],"a":"李白"},{"t":"《关山月》","k":[{"f":"明月出天山","b":"苍茫云海间"},{"f":"长风几万里","b":"吹度玉门关"},{"f":"汉下白登道","b":"胡窥青海湾"},{"f":"由来征战地","b":"不见有人还"},{"f":"戍客望边邑","b":"思归多苦颜"},{"f":"高楼当此夜","b":"叹息未应闲"}],"a":"李白"}]},{"t":"李商隐 1","k":[{"t":"《登乐游原》","k":[{"f":"向晚意不适","b":"驱车登古原"},{"f":"夕阳无限好","b":"只是近黄昏"}],"a":"李商隐"},{"t":"《贾生》","k":[{"f":"宣室求贤访逐臣","b":"贾生才调更无伦"},{"f":"可怜夜半虚前席","b":"不问苍生问鬼神"}],"a":"李商隐"},{"t":"《隋宫》","k":[{"f":"乘兴南游不戒严","b":"九重谁省谏书函"},{"f":"春风举国裁宫锦","b":"半作障泥半作帆"}],"a":"李商隐"},{"t":"《瑶池》","k":[{"f":"瑶池阿母绮窗开","b":"黄竹歌声动地哀"},{"f":"八骏日行三万里","b":"穆王何事不重来"}],"a":"李商隐"},{"t":"《嫦娥》","k":[{"f":"云母屏风烛影深","b":"长河渐落晓星沉"},{"f":"嫦娥应悔偷灵药","b":"碧海青天夜夜心"}],"a":"李商隐"},{"t":"《夜雨寄北》","k":[{"f":"君问归期未有期","b":"巴山夜雨涨秋池"},{"f":"何当共剪西窗烛","b":"却话巴山夜雨时"}],"a":"李商隐"},{"t":"《寄令狐郎中》","k":[{"f":"嵩云秦树久离居","b":"双鲤迢迢一纸书"},{"f":"休问梁园旧宾客","b":"茂陵秋雨病相如"}],"a":"李商隐"}]},{"t":"李商隐 2","k":[{"t":"《为有》","k":[{"f":"为有云屏无限娇","b":"凤城寒尽怕春宵"},{"f":"无端嫁得金龟婿","b":"辜负香衾事早朝"}],"a":"李商隐"},{"t":"《凉思》","k":[{"f":"客去波平槛","b":"蝉休露满枝"},{"f":"永怀当此节","b":"倚立自移时"},{"f":"北斗兼春远","b":"南陵寓使迟"},{"f":"天涯占梦数","b":"疑误有新知"}],"a":"李商隐"},{"t":"《北青萝》","k":[{"f":"残阳西入崦","b":"茅屋访孤僧"},{"f":"落叶人何在","b":"寒云路几层"},{"f":"独敲初夜磬","b":"闲倚一枝藤"},{"f":"世界微尘里","b":"吾宁爱与憎"}],"a":"李商隐"},{"t":"《蝉》","k":[{"f":"本以高难饱","b":"徒劳恨费声"},{"f":"五更疏欲断","b":"一树碧无情"},{"f":"薄宦梗犹泛","b":"故园芜已平"},{"f":"烦君最相警","b":"我亦举家清"}],"a":"李商隐"},{"t":"《风雨》","k":[{"f":"凄凉宝剑篇","b":"羁泊欲穷年"},{"f":"黄叶仍风雨","b":"青楼自管弦"},{"f":"新知遭薄俗","b":"旧好隔良缘"},{"f":"心断新丰酒","b":"销愁斗几千"}],"a":"李商隐"},{"t":"《落花》","k":[{"f":"高阁客竟去","b":"小园花乱飞"},{"f":"参差连曲陌","b":"迢递送斜晖"},{"f":"肠断未忍扫","b":"眼穿仍欲归"},{"f":"芳心向春尽","b":"所得是沾衣"}],"a":"李商隐"},{"t":"《无题·重帏深下莫愁堂》","k":[{"f":"重帏深下莫愁堂","b":"卧后清宵细细长"},{"f":"神女生涯原是梦","b":"小姑居处本无郎"},{"f":"风波不信菱枝弱","b":"月露谁教桂叶香"},{"f":"直道相思了无益","b":"未妨惆怅是清狂"}],"a":"李商隐"}]}]}