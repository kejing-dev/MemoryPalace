{"id":"tang300-15","zh":"唐诗三百首 · 卷十五","en":"300 Tang Poems · Vol. 15","tree":[{"t":"元结","k":[{"t":"《贼退示官吏》一","k":[{"f":"昔岁逢太平","b":"山林二十年"},{"f":"泉源在庭户","b":"洞壑当门前"},{"f":"井税有常期","b":"日晏犹得眠"},{"f":"忽然遭世变","b":"数岁亲戎旃"},{"f":"今来典斯郡","b":"山夷又纷然"},{"f":"城小贼不屠","b":"人贫伤可怜"}],"a":"元结"},{"t":"《贼退示官吏》二","k":[{"f":"是以陷邻境","b":"此州独见全"},{"f":"使臣将王命","b":"岂不如贼焉"},{"f":"今彼征敛者","b":"迫之如火煎"},{"f":"谁能绝人命","b":"以作时世贤"},{"f":"思欲委符节","b":"引竿自刺船"},{"f":"将家就鱼麦","b":"归老江湖边"}],"a":"元结"},{"t":"《石鱼湖上醉歌》","k":[{"f":"石鱼湖","b":"似洞庭 夏水欲满君山青"},{"f":"山为樽","b":"水为沼 酒徒历历坐洲岛"},{"f":"长风连日作大浪","b":"不能废人运酒舫"},{"f":"我持长瓢坐巴丘","b":"酌饮四坐以散愁"}],"a":"元结"}]},{"t":"丘为","k":[{"t":"《寻西山隐者不遇》","k":[{"f":"绝顶一茅茨","b":"直上三十里"},{"f":"扣关无僮仆","b":"窥室唯案几"},{"f":"若非巾柴车","b":"应是钓秋水"},{"f":"差池不相见","b":"黾勉空仰止"},{"f":"草色新雨中","b":"松声晚窗里"},{"f":"及兹契幽绝","b":"自足荡心耳"},{"f":"虽无宾主意","b":"颇得清净理"},{"f":"兴尽方下山","b":"何必待之子"}],"a":"丘为"}]},{"t":"綦毋潜","k":[{"t":"《春泛若耶溪》","k":[{"f":"幽意无断绝","b":"此去随所偶"},{"f":"晚风吹行舟","b":"花路入溪口"},{"f":"际夜转西壑","b":"隔山望南斗"},{"f":"潭烟飞溶溶","b":"林月低向后"},{"f":"生事且弥漫","b":"愿为持竿叟"}],"a":"綦毋潜"}]},{"t":"陈子昂","k":[{"t":"《登幽州台歌》","k":[{"f":"前不见古人","b":"后不见来者"},{"f":"念天地之悠悠","b":"独怆然而涕下"}],"a":"陈子昂"}]},{"t":"韩愈 1","k":[{"t":"《石鼓歌》一","k":[{"f":"张生手持石鼓文","b":"劝我试作石鼓歌"},{"f":"少陵无人谪仙死","b":"才薄将奈石鼓何"},{"f":"周纲凌迟四海沸","b":"宣王愤起挥天戈"},{"f":"大开明堂受朝贺","b":"诸侯剑佩鸣相磨"},{"f":"搜于岐阳骋雄俊","b":"万里禽兽皆遮罗"},{"f":"镌功勒成告万世","b":"凿石作鼓隳嵯峨"},{"f":"从臣才艺咸第一","b":"拣选撰刻留山阿"}],"a":"韩愈"},{"t":"《石鼓歌》二","k":[{"f":"雨淋日灸野火燎","b":"鬼物守护烦㧑呵"},{"f":"公从何处得纸本","b":"毫发尽备无差讹"},{"f":"辞严义密读难晓","b":"字体不类隶与蝌"},{"f":"年深岂免有缺画","b":"快剑斫断生蛟鼍"},{"f":"鸾翔凤翥众仙下","b":"珊瑚碧树交枝柯"},{"f":"金绳铁索锁钮壮","b":"古鼎跃水龙腾梭"},{"f":"陋儒编诗不收入","b":"二雅褊迫无委蛇"}],"a":"韩愈"},{"t":"《石鼓歌》三","k":[{"f":"孔子西行不到秦","b":"掎摭星宿遗羲娥"},{"f":"嗟余好古生苦晚","b":"对此涕泪双滂沱"},{"f":"忆昔初蒙博士征","b":"其年始改称元和"},{"f":"故人从军在右辅","b":"为我度量掘臼科"},{"f":"濯冠沐浴告祭酒","b":"如此至宝存岂多"},{"f":"毡包席裹可立致","b":"十鼓只载数骆驼"},{"f":"荐诸太庙比郜鼎","b":"光价岂止百倍过"}],"a":"韩愈"},{"t":"《石鼓歌》四","k":[{"f":"圣恩若许留太学","b":"诸生讲解得切磋"},{"f":"观经鸿都尚填咽","b":"坐见举国来奔波"},{"f":"剜苔剔藓露节角","b":