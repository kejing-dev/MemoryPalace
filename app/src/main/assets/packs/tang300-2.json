{"id":"tang300-2","zh":"唐诗三百首 · 卷二","en":"300 Tang Poems · Vol. 2","tree":[{"t":"王维 4","k":[{"t":"《渭城曲》","k":[{"f":"渭城朝雨浥轻尘","b":"客舍青青柳色新"},{"f":"劝君更尽一杯酒","b":"西出阳关无故人"}],"a":"王维"},{"t":"《秋夜曲》","k":[{"f":"桂魄初生秋露微","b":"轻罗已薄未更衣"},{"f":"银筝夜久殷勤弄","b":"心怯空房不忍归"}],"a":"王维"},{"t":"《洛阳女儿行》一","k":[{"f":"洛阳女儿对门居","b":"才可颜容十五余"},{"f":"良人玉勒乘骢马","b":"侍女金盘脍鲤鱼"},{"f":"画阁朱楼尽相望","b":"红桃绿柳垂檐向"},{"f":"罗帷送上七香车","b":"宝扇迎归九华帐"},{"f":"狂夫富贵在青春","b":"意气骄奢剧季伦"}],"a":"王维"},{"t":"《洛阳女儿行》二","k":[{"f":"自怜碧玉亲教舞","b":"不惜珊瑚持与人"},{"f":"春窗曙灭九微火","b":"九微片片飞花琐"},{"f":"戏罢曾无理曲时","b":"妆成祗是薰香坐"},{"f":"城中相识尽繁华","b":"日夜经过赵李家"},{"f":"谁怜越女颜如玉","b":"贫贱江头自浣纱"}],"a":"王维"},{"t":"《老将行》一","k":[{"f":"少年十五二十时","b":"步行夺得胡马骑"},{"f":"射杀山中白额虎","b":"肯数邺下黄须儿"},{"f":"一身转战三千里","b":"一剑曾当百万师"},{"f":"汉兵奋迅如霹雳","b":"虏骑崩腾畏蒺藜"},{"f":"卫青不败由天幸","b":"李广无功缘数奇"},{"f":"自从弃置便衰朽","b":"世事蹉跎成白首"},{"f":"昔时飞箭无全目","b":"今日垂杨生左肘"},{"f":"路旁时卖故侯瓜","b":"门前学种先生柳"}],"a":"王维"},{"t":"《老将行》二","k":[{"f":"苍茫古木连穷巷","b":"寥落寒山对虚牖"},{"f":"誓令疏勒出飞泉","b":"不似颍川空使酒"},{"f":"贺兰山下阵如云","b":"羽檄交驰日夕闻"},{"f":"节使三河募年少","b":"诏书五道出将军"},{"f":"试拂铁衣如雪色","b":"聊持宝剑动星文"},{"f":"愿得燕弓射大将","b":"耻令越甲鸣吾君"},{"f":"莫嫌旧日云中守","b":"犹堪一战取功勋"}],"a":"王维"},{"t":"《桃源行》一","k":[{"f":"渔舟逐水爱山春","b":"两岸桃花夹古津"},{"f":"坐看红树不知远","b":"行尽青溪不见人"},{"f":"山口潜行始隈隩","b":"山开旷望旋平陆"},{"f":"遥看一处攒云树","b":"近入千家散花竹"},{"f":"樵客初传汉姓名","b":"居人未改秦衣服"},{"f":"居人共住武陵源","b":"还从物外起田园"},{"f":"月明松下房栊静","b":"日出云中鸡犬喧"},{"f":"惊闻俗客争来集","b":"竞引还家问都邑"}],"a":"王维"},{"t":"《桃源行》二","k":[{"f":"平明闾巷扫花开","b":"薄暮渔樵乘水入"},{"f":"初因避地去人间","b":"及至成仙遂不还"},{"f":"峡里谁知有人事","b":"世中遥望空云山"},{"f":"不疑灵境难闻见","b":"尘心未尽思乡县"},{"f":"出洞无论隔山水","b":"辞家终拟长游衍"},{"f":"自谓经过旧不迷","b":"安知峰壑今来变"},{"f":"当时只记入山深","b":"青溪几度到云林"},{"f":"春来遍是桃花水","b":"不辨仙源何处寻"}],"a":"王维"}]},{"t":"白居易 1","k":[{"t":"《问刘十九》","k":[{"f":"绿蚁新醅酒","b":"红泥小火炉"},{"f":"晚来天欲雪","b":"能饮一杯无"}],"a":"白居易"},{"t":"《后宫词》","k":[{"f":"泪湿罗巾梦不成","b":"夜深前殿按歌声"},{"f":"红颜未老恩先断","b":"斜倚薰笼坐到明"}],"a":"白居易"},{"t":"《赋得古原草送别》","k":[{"f":"离离原上草","b":"一岁一枯荣"},{"f":"野火烧不尽","b":"春风吹又生"},{"f":"远芳侵古道","b":"晴翠接荒城"},{"f":"又送王孙去","b":"萋萋满别情"}],"a":"白居易"},{"t":"《望月有感》","k":[{"f":"时难年荒世业空","b":"弟兄羁旅各西东"},{"f":"田园寥落干戈后","b":"骨肉流离道路中"},{"f":"吊影分为千里雁","b":"辞根散作九秋蓬"},{"f":"共看明月应垂泪","b":"一夜乡心五处同"}],"a":"白居易"},{"t":"《长恨歌》一","k":[{"f":"汉皇重色思倾国","b":"御宇多年求不得"},{"f":"杨家有女初长成","b":"养在深闺人未识"},{"f":"天生丽质难自弃","b":"一朝选在君王侧"},{"f":"回眸一笑百媚生","b":"六宫粉黛无颜色"},{"f":"春寒赐浴华清池","b":"温泉水滑洗凝脂"},{"f":"侍儿扶起娇无力","b":"始是新承恩泽时"},{"f":"云鬓花颜金步摇","b":"芙蓉帐暖度春宵"},{"f":"春宵苦短日高起","b":"从此君王不早朝"}],"a":"白居易"},{"t":"《长恨歌》二","k":[{"f":"承欢侍宴无闲暇","b":"春从春游夜专夜"},{"f":"后宫佳丽三千人","b":"三千宠爱在一身"},{"f":"金屋妆成娇侍夜","b":"玉楼宴罢醉和春"},{"f":"姊妹弟兄皆列土","b":"可怜光彩生门户"},{"f":"遂令天下父母心","b":"不重生男重生女"},{"f":"骊宫高处入青云","b":"仙乐风飘处处闻"},{"f":"缓歌慢舞凝丝竹","b":"尽日君王看不足"},{"f":"渔阳鼙鼓动地来","b":"惊破霓裳羽衣曲"}],"a":"白居易"}]},{"t":"白居易 2","k":[{"t":"《长恨歌》三","k":[{"f":"九重城阙烟尘生","b":"千乘万骑西南行"},{"f":"翠华摇摇行复止","b":"西出都门百余里"},{"f":"六军不发无奈何","b":"宛转蛾眉马前死"},{"f":"花钿委地无人收","b":"翠翘金雀玉搔头"},{"f":"君王掩面救不得","b":"回看血泪相和流"},{"f":"黄埃散漫风萧索","b":"云栈萦纡登剑阁"},{"f":"峨嵋山下少人行","b":"旌旗无光日色薄"},{"f":"蜀江水碧蜀山青","b":"圣主朝朝暮暮情"}],"a":"白居易"},{"t":"《长恨歌》四","k":[{"f":"行宫见月伤心色","b":"夜雨闻铃肠断声"},{"f":"天旋地转回龙驭","b":"到此踌躇不能去"},{"f":"马嵬坡下泥土中","b":"不见玉颜空死处"},{"f":"君臣相顾尽沾衣","b":"东望都门信马归"},{"f":"归来池苑皆依旧","b":"太液芙蓉未央柳"},{"f":"芙蓉如面柳如眉","b":"对此如何不泪垂"},{"f":"春风桃李花开日","b":"秋雨梧桐叶落时"},{"f":"西宫南内多秋草","b":"落叶满阶红不扫"}],"a":"白居易"},{"t":"《长恨歌》五","k":[{"f":"梨园弟子白发新","b":"椒房阿监青娥老"},{"f":"夕殿萤飞思悄然","b":"孤灯挑尽未成眠"},{"f":"迟迟钟鼓初长夜","b":"耿耿星河欲曙天"},{"f":"鸳鸯瓦冷霜华重","b":"翡翠衾寒谁与共"},{"f":"悠悠生死别经年","b":"魂魄不曾来入梦"},{"f":"临邛道士鸿都客","b":"能以精诚致魂魄"},{"f":"为感君王辗转思","b":"遂教方士殷勤觅"}],"a":"白居易"},{"t":"《长恨歌》六","k":[{"f":"排空驭气奔如电","b":"升天入地求之遍"},{"f":"上穷碧落下黄泉","b":"两处茫茫皆不见"},{"f":"忽闻海上有仙山","b":"山在虚无缥渺间"},{"f":"楼阁玲珑五云起","b":"其中绰约多仙子"},{"f":"中有一人字太真","b":"雪肤花貌参差是"},{"f":"金阙西厢叩玉扃","b":"转教小玉报双成"},{"f":"闻道汉家天子使","b":"九华帐里梦魂惊"}],"a":"白居易"},{"t":"《长恨歌》七","k":[{"f":"揽衣推枕起徘徊","b":"珠箔银屏迤逦开"},{"f":"云鬓半偏新睡觉","b":"花冠不整下堂来"},{"f":"风吹仙袂飘飘举","b":"犹似霓裳羽衣舞"},{"f":"玉容寂寞泪阑干","b":"梨花一枝春带雨"},{"f":"含情凝睇谢君王","b":"一别音容两渺茫"},{"f":"昭阳殿里恩爱绝","b":"蓬莱宫中日月长"},{"f":"回头下望人寰处","b":"不见长安见尘雾"}],"a":"白居易"},{"t":"《长恨歌》八","k":[{"f":"惟将旧物表深情","b":"钿合金钗寄将去"},{"f":"钗留一股合一扇","b":"钗擘黄金合分钿"},{"f":"但教心似金钿坚","b":"天上人间会相见"},{"f":"临别殷勤重寄词","b":"词中有誓两心知"},{"f":"七月七日长生殿","b":"夜半无人私语时"},{"f":"在天愿作比翼鸟","b":"在地愿为连理枝"},{"f":"天长地久有时尽","b":"此恨绵绵无绝期"}],"a":"白居易"}]}]}